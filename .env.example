# =============================================================================
# BingX Trading Bot - Variables de entorno
# Copiar este archivo a ".env" y completar con valores reales.
# NUNCA commitear el archivo ".env" real al repositorio.
# =============================================================================

# --- Credenciales del Exchange (BingX) ---------------------------------------
# Requeridas incluso en modo paper para leer datos de mercado reales.
BINGX_API_KEY=tu_api_key_aqui
BINGX_API_SECRET=tu_api_secret_aqui

# --- Modo de ejecución ---------------------------------------------------------
# paper -> Simula órdenes localmente (Dry-Run), no envía órdenes reales al exchange.
# live  -> Envía órdenes reales a BingX. Usar solo tras validación exhaustiva en paper.
EXECUTION_MODE=paper

# Redundante con EXECUTION_MODE pero usado como guardia explícita adicional
# en puntos críticos de ejecución de órdenes. Debe coincidir con EXECUTION_MODE.
# true  = Dry-Run forzado (paper trading)
# false = Envío de órdenes reales habilitado
DRY_RUN=true

# --- Mercado -------------------------------------------------------------------
# Símbolo en formato CCXT unificado, ej: "BTC/USDT:USDT" para perpetuos USDT-M,
# o "BTC/USDT" para spot.
SYMBOL=BTC/USDT:USDT

# Tipo de mercado: "spot" o "swap" (futuros perpetuos)
MARKET_TYPE=swap

# Temporalidad de las velas (formato CCXT): 1m,5m,15m,1h,4h,1d...
TIMEFRAME=15m

# Apalancamiento (solo aplica si MARKET_TYPE=swap)
LEVERAGE=3

# --- Estrategia (EMA Cross + RSI + ATR) -----------------------------------------
EMA_FAST_PERIOD=12
EMA_SLOW_PERIOD=26
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0

# No hay Take Profit fijo: la salida es siempre por Stop Loss, que arranca en
# el nivel de ATR_SL_MULTIPLIER y desde ahí solo se desplaza a favor del
# trader según el canal Donchian de las últimas N velas (nunca retrocede),
# dejando correr la ganancia en tendencias sostenidas en vez de cortarla en
# un TP fijo. ATR_TP_MULTIPLIER se conserva por compatibilidad de sizing y
# se persiste a título informativo en el journal, pero no se usa para cerrar.
TRAILING_STOP_CHANNEL_PERIOD=55

# Filtro de tendencia opcional: 0 = desactivado. Si se configura (ej. 200), solo
# se toman señales LONG con precio por encima de esa EMA y SHORT por debajo.
TREND_FILTER_EMA_PERIOD=0

# Filtro de volatilidad mínima opcional: 0 = desactivado. Si se configura (ej. 1.0),
# exige que el ATR actual supere (ATR_SMA * este ratio) para tomar la señal,
# evitando operar en compresión de volatilidad (mercado plano/chop).
MIN_VOLATILITY_RATIO=0
VOLATILITY_SMA_PERIOD=20

# --- Gestión de riesgo -----------------------------------------------------------
# Porcentaje del balance disponible arriesgado por operación (ej: 1 = 1%)
RISK_PER_TRADE_PCT=1.0

# Límite de pérdida diaria acumulada. Al superarse, el bot congela nuevas
# aperturas de posición hasta el siguiente día UTC (Circuit Breaker).
DAILY_LOSS_LIMIT_PCT=2.0

# Máximo de posiciones simultáneas abiertas
MAX_OPEN_POSITIONS=1

# --- Paper trading (simulación) ---------------------------------------------------
# Balance inicial simulado en USDT
PAPER_INITIAL_BALANCE=1000.0

# Comisión taker simulada (0.05% = 0.0005)
PAPER_TAKER_FEE_PCT=0.05

# Slippage conservador simulado en porcentaje sobre el precio de entrada
PAPER_SLIPPAGE_PCT=0.05

# Ruta de la base de datos SQLite para persistir trades simulados
PAPER_DB_PATH=/data/trades_paper.db

# --- Core / Resiliencia -----------------------------------------------------------
# Intervalo del ciclo principal del bot, en segundos
LOOP_INTERVAL_SECONDS=30

# Reintentos máximos ante errores de red/exchange antes de esperar el próximo ciclo
MAX_RETRIES=5

# Backoff exponencial: espera base en segundos (backoff = BASE * 2^intento)
RETRY_BACKOFF_BASE_SECONDS=2

# Ruta de la base de datos SQLite del registro de aprendizaje (journal de trades
# con contexto de decisión y resultado). Se alimenta en paper Y en live, para
# poder analizar la performance de la estrategia con scripts/analyze_performance.py.
JOURNAL_DB_PATH=/data/journal.db

# --- Logging -----------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Zona horaria del contenedor ----------------------------------------------------
# Solo afecta la hora mostrada en logs de consola/archivo y en scripts/monitor_paper.py.
# Los timestamps persistidos en SQLite (trades_paper.db, journal.db) siempre se
# guardan en UTC explícito, independientemente de este valor — es el estándar
# correcto para datos persistidos y de lo que depende el circuit breaker de
# pérdida diaria (resetea a medianoche UTC).
TZ=America/Argentina/Buenos_Aires
